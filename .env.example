# Copy to .env.local and fill in. Supabase is only the server's database
# (branches, message log, template); staff sign in with HAL.
#   Dashboard → Project Settings → API Keys   (secret key)
#   Dashboard → Project Settings → General    (project ref)
# .env.local is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase, server-only. Must never gain a NEXT_PUBLIC_ prefix — `pnpm
# check:secrets` fails the build if one does.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Supabase CLI (used by `pnpm sb:link`, `pnpm db:push`, `pnpm types:gen`).
# Only needed on the machine you deploy from.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
# Dashboard → Project Settings → Database → Reset database password.
# Wrap in single quotes if it contains # @ $ or spaces: SUPABASE_DB_PASSWORD='p@ss#word'
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens — or run `supabase login` once
# instead and leave this empty.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OpenWA WhatsApp gateway (~/openwa/OpenWA, docker container `openwa-api`).
# Server-only — never NEXT_PUBLIC_. Key: `docker exec openwa-api cat data/.api-key`
# ---------------------------------------------------------------------------
OPENWA_URL=http://127.0.0.1:2785
OPENWA_API_KEY=owa_k1_xxx

# ---------------------------------------------------------------------------
# HAL admin API. Staff sign in with their HAL account; the token is kept in an
# encrypted httpOnly cookie. SESSION_SECRET: `openssl rand -base64 48`
# ---------------------------------------------------------------------------
HAL_API_URL=https://hal.hal-logistics.la
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Development account (optional). Signing in with this email skips HAL and
# opens a demo branch with mock bills you can generate. Any other email signs
# in with HAL as usual. Leave DEV_LOGIN_EMAIL empty in production.
# Quote the password if it contains # @ $ or spaces.
# ---------------------------------------------------------------------------
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
